{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/executar.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/mp4-muxer/build/mp4-muxer.js"
    },
    "api/posts.ts": {
      "maxDuration": 30
    },
    "api/aprovar.ts": {
      "maxDuration": 30
    },
    "api/acordar.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/mp4-muxer/build/mp4-muxer.js"
    },
    "api/publicar-agendados.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/mp4-muxer/build/mp4-muxer.js"
    },
    "api/conectar-instagram.ts": {
      "maxDuration": 30
    },
    "api/ideias.ts": {
      "maxDuration": 60
    },
    "api/financeiro.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
